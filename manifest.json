{
  "manifest_version": 3,
  "name": "Gmail Sender Sift",
  "version": "1.0.0",
  "description": "Group your Gmail inbox by sender and batch archive or trash. No accounts, no server: talks straight to the Gmail API.",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://mail.google.com/*", "https://gmail.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
